# Redireciona www -> sem www, em definitivo (301).
# Sem isso o Google ve www.frutasbeca.com e frutasbeca.com como
# duas paginas identicas, e divide a relevancia entre as duas.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.frutasbeca\.com$ [NC]
  RewriteRule ^(.*)$ https://frutasbeca.com/$1 [R=301,L]
</IfModule>

# Cache de assets estaticos (imagens, video, css, js, fontes) — HTML sempre revalida.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Cabecalhos basicos de seguranca + cache
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "\.(jpg|jpeg|png|svg|mp4|css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Tipo correto para .vcf (caso algum dia seja servido como arquivo)
AddType text/vcard .vcf
AddType video/mp4 .mp4
